# For Vercel deployment, create a free Supabase project and copy its URL and publishable key.
# Leave unset for local development with npm run dev.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: Cloudflare Realtime TURN (ADR 010). Leave both unset to fall back to
# STUN-only. Create a TURN Server app at dash.cloudflare.com > Realtime > TURN Server.
# Server-side secrets only — never prefix with NEXT_PUBLIC_.
CLOUDFLARE_TURN_TOKEN_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Desktop only: the deployed web app's URL, so the Electron app can fetch TURN
# credentials from /api/turn (it has no server of its own). Unused by the web build.
NEXT_PUBLIC_APP_URL=
